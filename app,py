# ---------------- LOAD MODELS ----------------
crankshaft_model = joblib.load("crankshaft_model.pkl")
gear_model = joblib.load("gear_model.pkl")
gearshaft_model = joblib.load("gearshaft_model.pkl")
bearing_model = joblib.load("bearing_model.pkl")

# ---------------- TITLES ----------------
st.markdown(
    '<div class="main-title">AI Predictive Maintenance System</div>',
    unsafe_allow_html=True
)

st.markdown(
    '<div class="subtitle">ANSYS + Machine Learning Based Mechanical Failure Prediction Platform</div>',
    unsafe_allow_html=True
)

# ---------------- COMPONENT SELECT ----------------
component = st.selectbox(
    "Select Mechanical Component",
    ["Crankshaft", "Gear", "Gear Shaft", "Bearing"]
)

# ---------------- INPUTS ----------------
col1, col2, col3 = st.columns(3)

with col1:
    load = st.number_input("Load / Torque")

with col2:
    tot_def = st.number_input("Total Deformation")

with col3:
    direct_def = st.number_input("Directional Deformation")

col4, col5, col6 = st.columns(3)

with col4:
    eqv_str = st.number_input("Equivalent Elastic Strain")

with col5:
    eqv_stress = st.number_input("Equivalent Stress")

with col6:
    str_energy = st.number_input("Strain Energy")

# ---------------- PREDICT BUTTON ----------------
if st.button("Predict Condition"):

    sample = np.array([[
        load,
        tot_def,
        direct_def,
        eqv_str,
        eqv_stress,
        str_energy
    ]])

    # MODEL SELECTION
    if component == "Crankshaft":
        prediction = crankshaft_model.predict(sample)

    elif component == "Gear":
        prediction = gear_model.predict(sample)

    elif component == "Gear Shaft":
        prediction = gearshaft_model.predict(sample)

    else:
        prediction = bearing_model.predict(sample)

    # RESULT DISPLAY
    st.markdown(
        f'''
        <div class="result-box">
            Predicted Condition: {prediction[0]}
        </div>
        ''',
        unsafe_allow_html=True
    )
